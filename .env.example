# Frontend (Client) Environment Variables
# In Vercel, set this to your deployed Render backend URL (e.g. https://sentinel-ai-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Backend (Server) Environment Variables
# In Render, PORT is automatically injected by the platform.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=sentinel-ai-super-secure-runtime-gateway-key-2025
CORS_ORIGINS=["http://localhost:5173","https://*.vercel.app"]
